# Base PostgreSQL dédiée aux tests d'intégration.
# Ne jamais pointer vers la base de production ni vers la base de recette.
# Si la variable est absente, les tests d'intégration qui exigent une base sont ignorés.
TEST_DATABASE_URL=postgresql://gd_trading_test:mot_de_passe_local@localhost:5432/gd_trading_test

# URL de base utilisée par Playwright (application lancée manuellement ou par la CI).
E2E_BASE_URL=http://localhost:3000
